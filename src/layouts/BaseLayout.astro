---
import { readFileSync } from 'fs';
import { resolve } from 'path';
import yaml from 'js-yaml';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'ss14lab', description = 'Community reference for Space Station 14' } = Astro.props;

const serversYaml = yaml.load(
  readFileSync(resolve('./src/data/servers.yaml'), 'utf8')
) as { servers: { id: string; label: string }[] };
const servers = serversYaml.servers;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — ss14lab</title>
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap');

      :root {
        --font-mono: 'JetBrains Mono', 'Fira Mono', 'Cascadia Code', ui-monospace, monospace;
        --font-sans: system-ui, -apple-system, sans-serif;

        --color-background-base: #090d09;
        --color-background-primary: #0e140e;
        --color-background-secondary: #131a13;
        --color-background-tertiary: #1a231a;

        --color-background-success: #0a1a0d;
        --color-background-info: #090f1a;
        --color-background-warning: #1a1200;
        --color-background-danger: #1a0909;

        --color-text-primary: #d4dbd4;
        --color-text-secondary: #8a9e8a;
        --color-text-tertiary: #526052;

        --color-text-success: #4ade80;
        --color-text-info: #60a5fa;
        --color-text-warning: #fbbf24;
        --color-text-danger: #f87171;

        --color-border-primary: #2a382a;
        --color-border-secondary: #1e2a1e;
        --color-border-tertiary: #182018;

        --color-border-success: #166534;
        --color-border-info: #1e3a5f;
        --color-border-warning: #78350f;
        --color-border-danger: #7f1d1d;

        --border-radius-sm: 4px;
        --border-radius-md: 6px;
        --border-radius-lg: 10px;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html {
        background-color: var(--color-background-base);
        color: var(--color-text-primary);
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.6;
        background-image:
          linear-gradient(rgba(74, 222, 128, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(74, 222, 128, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        min-height: 100vh;
      }

      body { min-height: 100vh; }

      a { color: var(--color-text-info); text-decoration: none; }
      a:hover { text-decoration: underline; }

      /* ── Nav ─────────────────────────────────────────────────────────────── */
      .site-nav {
        border-bottom: 0.5px solid var(--color-border-secondary);
        background: rgba(9, 13, 9, 0.9);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 200;
      }

      .site-nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        height: 48px;
      }

      .site-logo {
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 500;
        color: var(--color-text-success);
        text-decoration: none;
        letter-spacing: 0.04em;
        flex-shrink: 0;
      }
      .site-logo:hover { text-decoration: none; opacity: 0.8; }

      .site-nav-links {
        display: flex;
        gap: 1.25rem;
        list-style: none;
        flex-shrink: 0;
      }
      .site-nav-links a {
        font-size: 11px;
        color: var(--color-text-tertiary);
        text-decoration: none;
        font-family: var(--font-mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .site-nav-links a:hover { color: var(--color-text-secondary); }

      /* ── Search ──────────────────────────────────────────────────────────── */
      .nav-search-wrap {
        position: relative;
        flex: 1;
        min-width: 180px;
        max-width: 480px;
        margin-left: auto;
      }

      .nav-search {
        width: 100%;
        font-family: var(--font-mono);
        font-size: 12px;
        padding: 5px 10px 5px 28px;
        border-radius: var(--border-radius-md);
        border: 0.5px solid var(--color-border-secondary);
        background: var(--color-background-secondary);
        color: var(--color-text-primary);
        outline: none;
        transition: border-color 0.15s;
      }
      .nav-search::placeholder { color: var(--color-text-tertiary); }
      .nav-search:focus { border-color: var(--color-border-primary); }

      .nav-search-icon {
        position: absolute;
        left: 8px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-text-tertiary);
        font-size: 11px;
        pointer-events: none;
        font-family: var(--font-mono);
      }

      .search-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: var(--color-background-secondary);
        border: 0.5px solid var(--color-border-primary);
        border-radius: var(--border-radius-md);
        overflow: hidden;
        display: none;
        z-index: 300;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      }
      .search-dropdown.open { display: block; }

      .search-result {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 3px;
        padding: 7px 12px;
        cursor: pointer;
        border-bottom: 0.5px solid var(--color-border-tertiary);
        text-decoration: none;
      }
      .search-result:last-child { border-bottom: none; }
      .search-result:hover, .search-result.focused {
        background: var(--color-background-tertiary);
      }
      .sr-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
      }
      .sr-body { align-items: flex-start; }
      .search-result-name {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--color-text-primary);
        flex: 1;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .search-result-name em {
        font-style: normal;
        color: var(--color-text-success);
      }
      .search-result-desc {
        font-size: 11px;
        color: var(--color-text-tertiary);
        line-height: 1.4;
        flex: 1;
        min-width: 0;
      }
      .search-result-desc em {
        font-style: normal;
        color: var(--color-text-success);
      }
      .search-result-tag {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--color-text-tertiary);
        padding: 1px 6px;
        border-radius: 100px;
        border: 0.5px solid var(--color-border-tertiary);
        flex-shrink: 0;
      }
      .sr-effects {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
      }
      .sr-fx-col {
        display: flex;
        flex-direction: column;
        gap: 2px;
        align-items: flex-end;
      }
      .sr-heal, .sr-deal {
        font-family: var(--font-mono);
        font-size: 10px;
        white-space: nowrap;
      }
      .sr-heal { color: var(--color-text-success); }
      .sr-deal { color: var(--color-text-danger); }
      .search-empty {
        padding: 10px 12px;
        font-size: 12px;
        color: var(--color-text-tertiary);
        font-family: var(--font-mono);
      }

      /* ── Server pill ─────────────────────────────────────────────────────── */
      .server-pill-wrap {
        position: relative;
        flex-shrink: 0;
      }

      .server-pill {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 4px 10px;
        min-width: 90px;
        border-radius: 100px;
        border: 0.5px solid var(--color-border-success);
        background: var(--color-background-success);
        color: var(--color-text-success);
        cursor: pointer;
        user-select: none;
        transition: filter 0.1s;
      }
      .server-pill:hover { filter: brightness(1.15); }
      .server-pill-chevron {
        font-size: 9px;
        opacity: 0.7;
        transition: transform 0.15s;
      }
      .server-pill-wrap.open .server-pill-chevron { transform: rotate(180deg); }

      .server-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        background: var(--color-background-secondary);
        border: 0.5px solid var(--color-border-primary);
        border-radius: var(--border-radius-md);
        overflow: hidden;
        display: none;
        z-index: 300;
        min-width: 110px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      }
      .server-pill-wrap.open .server-dropdown { display: block; }

      .server-option {
        display: block;
        width: 100%;
        padding: 7px 14px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--color-text-secondary);
        background: none;
        border: none;
        border-bottom: 0.5px solid var(--color-border-tertiary);
        cursor: pointer;
        text-align: left;
        transition: background 0.1s, color 0.1s;
      }
      .server-option:last-child { border-bottom: none; }
      .server-option:hover { background: var(--color-background-tertiary); color: var(--color-text-primary); }
      .server-option.active { color: var(--color-text-success); }

      /* ── Page ────────────────────────────────────────────────────────────── */
      .page-content {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
    </style>
  </head>
  <body>
    <nav class="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="site-logo">ss14lab</a>
        <ul class="site-nav-links">
          <li><a href="/chems">chems</a></li>
          <li><a href="/drinks">drinks</a></li>
          <li><a href="/food">food</a></li>
        </ul>

        <!-- Global search -->
        <div class="nav-search-wrap">
          <span class="nav-search-icon">/</span>
          <input
            type="text"
            class="nav-search"
            id="nav-search"
            placeholder="search... ⌘K"
            autocomplete="off"
            spellcheck="false"
          />
          <div class="search-dropdown" id="search-dropdown"></div>
        </div>

        <!-- Server pill — sole UI for switching servers -->
        <div class="server-pill-wrap" id="server-pill-wrap">
          <div class="server-pill" id="server-pill">
            <span id="server-pill-label">delta-v</span>
            <span class="server-pill-chevron">▾</span>
          </div>
          <div class="server-dropdown" id="server-dropdown">
            {servers.map((s) => (
              <button class="server-option" data-server={s.id}>{s.label}</button>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <main class="page-content">
      <slot />
    </main>

    <script>
      import { getServer, setServer } from '../scripts/server-store';
      import { initSearch } from '../scripts/search';

      // ── Server pill ────────────────────────────────────────────────────────

      function updatePillUI(server: string) {
        const label = document.getElementById('server-pill-label');
        if (label) label.textContent = server;
        document.querySelectorAll<HTMLElement>('.server-option').forEach((btn) => {
          btn.classList.toggle('active', btn.dataset.server === server);
        });
      }

      const pillWrap = document.getElementById('server-pill-wrap')!;
      const pill = document.getElementById('server-pill')!;

      pill.addEventListener('click', (e) => {
        e.stopPropagation();
        pillWrap.classList.toggle('open');
      });

      document.querySelectorAll<HTMLElement>('.server-option').forEach((btn) => {
        btn.addEventListener('click', () => {
          const server = btn.dataset.server!;
          updatePillUI(server);
          setServer(server); // writes localStorage + dispatches ss14:server-change
          pillWrap.classList.remove('open');
        });
      });

      document.addEventListener('click', () => {
        pillWrap.classList.remove('open');
      });

      // Init: update UI without dispatching the change event
      updatePillUI(getServer());

      // Init search (Cmd+K, dropdown, keyboard nav)
      initSearch();
    </script>
  </body>
</html>
